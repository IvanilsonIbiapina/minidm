{
  "manifest_version": 3,
  "name": "minidm bridge",
  "version": "2.0",
  "description": "Captura vídeos da página e envia links para o minidm (API local em 127.0.0.1:9742).",
  "permissions": [
    "contextMenus",
    "notifications",
    "storage",
    "webRequest",
    "activeTab",
    "scripting",
    "tabs",
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:9742/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "minidm — vídeos detectados",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
